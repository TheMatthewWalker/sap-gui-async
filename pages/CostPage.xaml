<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="costing_tool.pages.CostPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:local="using:costing_tool.pages" 
      xmlns:models="using:costing_tool.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls" 
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    
    <Grid RowDefinitions="Auto,*" Padding="24">
        
        <!-- HEADER -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
            <Button Content="← Back" Click="Back_Click" Style="{StaticResource AccentButtonStyle}" Width="120" />
            <TextBlock Text="Material Costing" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" Padding="8">
                
                <!-- CARD: Selected Item Details -->
                <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#FFCCCCCC" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Search Criteria" FontSize="20" FontWeight="SemiBold"/>

                        <!-- ItemsControl for dynamic rows -->
                        <ItemsControl ItemsSource="{Binding CriteriaRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchCriteriaRow">
                                    <Grid ColumnSpacing="12" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <!-- Row Number -->
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Delete Button -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Row Number -->
                                        <TextBlock Grid.Column="0" Text="{Binding  RowNumber, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold"/>

                                        <!-- Inputs -->
                                        <TextBox Grid.Column="1" Text="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Material"/>
                                        <TextBox Grid.Column="2" Text="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Volume"/>
                                        <TextBox Grid.Column="3" Text="{Binding Incoterms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Incoterms"/>
                                        <TextBox Grid.Column="4" Text="{Binding Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Country"/>
                                        <!-- Delete Button -->
                                        <Button Grid.Column="5" Content="🗑" Click="DeleteRowButton_Click" ToolTipService.ToolTip="Delete Row"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Row Button -->
                        <Button Content="➕ Add Row" HorizontalAlignment="Right" Click="AddRowButton_Click" Width="120"/>
                    </StackPanel>
                </Border>
                
                <!-- CREATE BUTTON -->
                <Button x:Name="CalcButton" Content="Calculate Cost" Click="Read_Table_Click" Height="48" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" FontSize="18"/>

                <TextBlock x:Name="StatusText" Text="" Margin="0,10,0,0"/>
                <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Visibility="Collapsed"/>
                
                <!-- SAP RESULT MESSAGE -->
                <Border Background="#FFF5F5F5" CornerRadius="8" Padding="12" BorderBrush="#FFCCCCCC" BorderThickness="1">
                    <toolkit:DataGrid x:Name="SapDataGrid" 
                                      AutoGenerateColumns="True" 
                                      HeadersVisibility="Column" 
                                      IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" 
                                      CanUserSortColumns="True" 
                                      Height="400" 
                                      RightTapped="SapDataGrid_RightTapped">

                        <toolkit:DataGrid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="View Cost Breakdown" Icon="View" Click="ViewCost_Click"/>
                            </MenuFlyout>
                        </toolkit:DataGrid.ContextFlyout>
                        
                    </toolkit:DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>