<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="costing_tool.pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="ms-appx:///Assets/logo.png"
                           Width="250"
                           Height="250"
                           HorizontalAlignment="Center"/>
        <TextBox x:Name="sapSystem"
                 PlaceholderText="SAP System"
                 FontSize="18"
                 Width="250"
                 Margin="0,0,0,20"
                 HorizontalAlignment="Center"/>
        <TextBox x:Name="sapUsername"
                 PlaceholderText="SAP Username"
                 FontSize="18"
                 Width="250"
                 Margin="0,0,0,20"
                 HorizontalAlignment="Center"/>
        <PasswordBox x:Name="sapPassword"
                 PlaceholderText="SAP Password"
                 Width="250"
                 FontSize="18"
                 Margin="0,0,0,20"
                 HorizontalAlignment="Center"/>
        <Button x:Name="LoginButton"
                Content="Login"
                Width="250"
                HorizontalAlignment="Center"
                Click="Login_Click"/>
        <TextBox x:Name="sapMessage"
                 PlaceholderText=""
                 FontSize="18"
                 Width="250"
                 Margin="0,0,0,20"
                 HorizontalAlignment="Center"
                 Visibility="Collapsed"/>
    </StackPanel>
</Page>