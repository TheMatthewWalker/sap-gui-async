<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="costing_tool.pages.MixingPage" 
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:local="using:costing_tool.pages" 
	  xmlns:models="using:costing_tool.Models"
      xmlns:services="using:costing_tool.Services"
      xmlns:converters="using:costing_tool.Converters"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls" 
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:NullOrEmptyStringConverter x:Key="NullOrEmptyStringConverter"/>
    </Page.Resources>


    <Grid RowDefinitions="Auto,*" Padding="24">

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
            <Button Content="← Back" Click="Back_Click" Style="{StaticResource AccentButtonStyle}" Width="120" />
            <TextBlock Text="Mixing" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" Padding="8">

                <!-- CARD: Selected Item Details -->
                <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#FFCCCCCC" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Search Criteria" FontSize="20" FontWeight="SemiBold"/>

                        <!-- ItemsControl for dynamic rows -->
                        <ItemsControl ItemsSource="{Binding MixingCriteria, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MixingCriteria">
                                    <Grid ColumnSpacing="12" VerticalAlignment="Center" Margin="0,0,0,8">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="40"/>  <!-- Row Number -->
											<ColumnDefinition Width="*"/>   <!-- MixingID -->
											<ColumnDefinition Width="*"/>   <!-- MixCode -->
											<ColumnDefinition Width="*"/>   <!-- TotalWeight -->
											<ColumnDefinition Width="*"/>   <!-- Shift -->
											<ColumnDefinition Width="*"/>   <!-- Operator -->
											<ColumnDefinition Width="*"/>   <!-- SupplierBatch -->
											<ColumnDefinition Width="*"/>   <!-- BatchTub -->
											<ColumnDefinition Width="*"/>   <!-- CreationDate (From) -->
											<ColumnDefinition Width="*"/>   <!-- DateTo -->
											<ColumnDefinition Width="*"/>   <!-- CreationTime -->
											<ColumnDefinition Width="*"/>   <!-- Comment -->
											<ColumnDefinition Width="Auto"/><!-- Delete -->
										</Grid.ColumnDefinitions>

                                        <!-- Row Number -->
                                        <TextBlock Grid.Column="0" Text="{Binding  RowNumber, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold"/>

										<!-- Inputs -->
										<TextBox Grid.Column="1"  Text="{Binding MixingID, Mode=TwoWay}"      PlaceholderText="MixingID"/>
										<TextBox Grid.Column="2"  Text="{Binding MixCode, Mode=TwoWay}"        PlaceholderText="MixCode"/>
										<TextBox Grid.Column="3"  Text="{Binding TotalWeight, Mode=TwoWay}"    PlaceholderText="TotalWeight"/>
                                        <ComboBox Grid.Column="4"
                                                  ItemsSource="{Binding ShiftOptions, ElementName=PageRoot}"
                                                  SelectedItem="{Binding Shift, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="Shift">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding Converter={StaticResource NullOrEmptyStringConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Column="5"  Text="{Binding Operator, Mode=TwoWay}"       PlaceholderText="Operator"/>
										<TextBox Grid.Column="6"  Text="{Binding SupplierBatch, Mode=TwoWay}"  PlaceholderText="SupplierBatch"/>
										<TextBox Grid.Column="7"  Text="{Binding BatchTub, Mode=TwoWay}"       PlaceholderText="BatchTub"/>
                                        <DatePicker Grid.Column="8"   Date="{Binding CreationDate, Mode=TwoWay}" Header="Date From" HorizontalAlignment="Stretch"/>
                                        <DatePicker Grid.Column="9"  Date="{Binding DateTo, Mode=TwoWay}" Header="Date To" HorizontalAlignment="Stretch"/>
										<TextBox Grid.Column="10" Text="{Binding CreationTime, Mode=TwoWay}"   PlaceholderText="CreationTime"/>
										<TextBox Grid.Column="11" Text="{Binding Comment, Mode=TwoWay}"        PlaceholderText="Comment"/>

										<!-- Delete Button -->
										<Button Grid.Column="12" Content="🗑" Click="DeleteRowButton_Click" ToolTipService.ToolTip="Delete Row"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Row Button -->
                        <Button Content="➕ Add Row" HorizontalAlignment="Right" Click="AddRowButton_Click" Width="120"/>
                    </StackPanel>
                </Border>

                <!-- CREATE BUTTON -->
                <Button x:Name="QueryButton" Content="Search Mixing" Click="Sql_Query_Click" Height="48" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" FontSize="18"/>

                <TextBlock x:Name="StatusText" Text="" Margin="0,10,0,0"/>
                <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Visibility="Collapsed"/>

                <!-- SAP RESULT MESSAGE -->
                <Border Background="#FFF5F5F5" CornerRadius="8" Padding="12" BorderBrush="#FFCCCCCC" BorderThickness="1">
                    <toolkit:DataGrid x:Name="SqlDataGrid" 
                                      AutoGenerateColumns="True" 
                                      HeadersVisibility="Column" 
                                      IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" 
                                      CanUserSortColumns="True" 
                                      Height="400" 
                                      RightTapped="SqlDataGrid_RightTapped">

                        <toolkit:DataGrid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="View" Icon="View" Click="View_Details_Click"/>
                                <MenuFlyoutItem Text="Edit" Icon="Edit" Click="Edit_Details_Click"/>
                                <MenuFlyoutItem Text="Reprint" Icon="Print" Click="Reprint_Click"/>
                            </MenuFlyout>
                        </toolkit:DataGrid.ContextFlyout>

                    </toolkit:DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>